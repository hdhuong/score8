# Copy file này thành .env.local (đã có trong .gitignore) rồi điền giá trị
# thật từ Supabase Project Settings > API.
#
# Nếu để trống / không tạo .env.local, app vẫn chạy bình thường ở chế độ
# offline hoàn toàn (chỉ dùng localStorage, không có đồng bộ cloud).

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dùng cho tính năng "Phân tích bằng AI" (api/analyze-team.ts — Vercel Edge
# Function). QUAN TRỌNG: KHÔNG thêm tiền tố VITE_ cho 2 biến này — biến
# VITE_* bị nhúng thẳng vào bundle client, còn 2 biến này chỉ được đọc ở
# server (Edge Function), không bao giờ lộ ra trình duyệt.
#
# - Set trên Vercel: Project Settings > Environment Variables (hoặc
#   `vercel env add GEMINI_API_KEY` nếu dùng vercel CLI).
# - Test local: cần chạy `vercel dev` (vercel CLI) thay vì `npm run dev`,
#   vì route /api/* không chạy dưới `vite dev` thuần — khi đó gọi
#   /api/analyze-team sẽ trả 404.
# - Lấy API key tại https://aistudio.google.com/apikey.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dùng alias "-latest" thay vì ghim version cụ thể (vd gemini-2.5-flash-lite)
# — Google thường xuyên deprecate version cụ thể cho tài khoản mới, alias tự
# trỏ sang model thay thế còn được hỗ trợ.
GEMINI_MODEL=gemini-flash-lite-latest
